//@version=6
// TMG-inspirert datavisning, ikke Stonksys eller kanalens proprietære kode.
// Kilde: youtube.com/watch?v=6JiCtRBSsGo&t=337 og OCnkVk2KG7o&t=240.
// Måler samme mynts spot-/perp-basevolum på én børs, ikke global USD-ordreflyt.
// Forskningskandidaten reduserte tap på BTC, men ble ikke godkjent som strategi.
// Panelet legger ingen ordre og har ingen kjøps-/salgssignaler.
indicator("TMG · Spotdeltakelse (forskningspanel)", "TMG spotvolum", overlay=false, max_bars_back=1000)

string spotSymbol = input.symbol("BINANCE:BTCUSDT", "Spotsymbol · samme mynt som futures")
string perpSymbol = input.symbol("BINANCE:BTCUSDT.P", "Futuressymbol · samme mynt som spot")

[spot24, spotPrior720] = request.security(spotSymbol, "60", [math.sum(volume, 24), math.sum(volume[24], 720)], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
[perp24, perpPrior720] = request.security(perpSymbol, "60", [math.sum(volume, 24), math.sum(volume[24], 720)], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
float participation = perp24 > 0 ? spot24 / perp24 : na
float priorParticipation = perpPrior720 > 0 ? spotPrior720 / perpPrior720 : na
bool known = not na(participation) and not na(priorParticipation)
bool supported = known and participation >= priorParticipation
bool validTf = timeframe.in_seconds() == 3600
int utcDay = dayofweek(time_close, "UTC")
bool weekend = utcDay == dayofweek.saturday or utcDay == dayofweek.sunday
bool weekendPass = not weekend or supported
bool confirmed = validTf and barstate.isconfirmed

plot(confirmed ? participation * 100 : na, "Spot/futures · siste 24 timer (%)", color=#00DCB9, linewidth=2)
plot(confirmed ? priorParticipation * 100 : na, "Spot/futures · foregående 30 dager (%)", color=#5F9BFF, linewidth=2)
bgcolor(confirmed and weekend ? (weekendPass ? color.new(color.green, 88) : color.new(color.red, 88)) : na, title="Helgens volumkrav")

var table status = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.cell(status, 0, 0, "TMG · forskningspanel", text_color=color.white)
    table.cell(status, 1, 0, "Ingen ordre", text_color=color.yellow)
    table.cell(status, 0, 1, "Tidsintervall", text_color=color.white)
    table.cell(status, 1, 1, validTf ? "1 time" : "Velg 1 time", text_color=validTf ? color.white : color.red)
    table.cell(status, 0, 2, "Spotdeltakelse", text_color=color.white)
    table.cell(status, 1, 2, not known ? "Mangler data / 744 timers oppvarming" : supported ? "Over eget referansenivå" : "Under eget referansenivå", text_color=supported ? color.green : color.orange)
    table.cell(status, 0, 3, "Helgens volumkrav", text_color=color.white)
    table.cell(status, 1, 3, not validTf ? "Ugyldig intervall" : not barstate.isconfirmed ? "Venter på lukking" : not weekend ? "Ukedag · ikke brukt" : weekendPass ? "Oppfylt" : "Ikke oppfylt", text_color=color.white)
    table.cell(status, 0, 4, "Forskningsstatus", text_color=color.white)
    table.cell(status, 1, 4, "Ikke godkjent til automatisk handel", text_color=color.orange)
