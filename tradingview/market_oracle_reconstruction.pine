//@version=6
// Selvstendig, DELVIS ESTIMERT rekonstruksjon fra offentlig beskrivelse og graf.
// Ikke ChartPrimes lukkede kildekode. Alle formler under er åpne tolkninger.
// Referanse: https://www.tradingview.com/script/sIv1KNBS-Market-Oracle-Pro-ChartPrime/
// 2023-grafen viser Trend/Tuning 14. Optimizer, Max Profit og Market Prophecy
// er ikke rekonstruert. Ingen bakoverplasserte signaler eller fremtidsdata.
indicator("Market Oracle Pro · Estimated Reconstruction", "Oracle Recon · estimert", overlay=true, max_labels_count=500)

signalMode = input.string("Trend", "Signal Mode", options=["Trend", "Reversal", "Trend + Reversal", "Disabled"], group="Signal Settings")
tuning = input.float(14.0, "Tuning", minval=3, maxval=100, step=1, group="Signal Settings")
showTP = input.bool(true, "Take Profit · egne ATR-nivåer", group="Signal Settings")
candleMode = input.string("Trend Gradient", "Candle Highlighting", options=["Japanese Default", "Trend Gradient", "Trend Static"], group="Signal Settings")
showScore = input.bool(true, "Prime Score · estimert", group="Dashboard")
showConsolidation = input.bool(true, "Consolidation Score · estimert", group="Dashboard")
showDashboard = input.bool(true, "Vis dashboard", group="Dashboard")
reactorSelect = input.string("Disabled", "Reactor Select", options=["Disabled", "Dynamic Reactor", "Volume Flex Reactor", "Both"], group="Additional Features")
showBands = input.bool(false, "Momentum Wave Bands · estimert", group="Additional Features")
showCandles = input.bool(false, "Candle Structures · estimert", group="Additional Features")
showRanges = input.bool(false, "Prime Range · estimert rullerende VWAP", group="Additional Features")
showAssistant = input.bool(false, "Prime Trend Assistant · estimert", group="Additional Features")
showPlan = input.bool(true, "Vis egen SL/TP-plan", group="WEEX-risikoprofil · egne regler")
stopATR = input.float(2.0, "SL × ATR14", minval=0.1, maxval=10, step=0.1, group="WEEX-risikoprofil · egne regler")
tp1ATR = input.float(2.0, "TP1 × ATR14 · 50 prosent", minval=0.1, maxval=20, step=0.1, group="WEEX-risikoprofil · egne regler")
tp2ATR = input.float(3.0, "TP2 × ATR14 · resten", minval=0.2, maxval=30, step=0.1, group="WEEX-risikoprofil · egne regler")

// Ehlers-lignende topols lavpass. ATR-hysterese gir en stabil trendtilstand.
// Dette er en tolkning av beskrivelsens DSP-filter, ikke en identifisert formel.
period = int(math.round(tuning))
a1 = math.exp(-math.sqrt(2.0) * math.pi / period)
b1 = 2.0 * a1 * math.cos(math.sqrt(2.0) * math.pi / period)
c1 = 1.0 - b1 + a1 * a1
var float filtered = na
filtered := bar_index < 2 ? close : c1 * (close + close[1]) / 2.0 + b1 * nz(filtered[1], close) - a1 * a1 * nz(filtered[2], close)
atr = ta.atr(14)
var float lower = na
var float upper = na
lower := filtered - 2.0 * atr
upper := filtered + 2.0 * atr
lower := close[1] > nz(lower[1], lower) ? math.max(lower, nz(lower[1], lower)) : lower
upper := close[1] < nz(upper[1], upper) ? math.min(upper, nz(upper[1], upper)) : upper
var int trend = 1
trend := close > nz(upper[1], upper) ? 1 : close < nz(lower[1], lower) ? -1 : trend
ready = bar_index >= 30 and not na(atr) and atr > 0
trendBuy = ready and trend == 1 and trend[1] == -1
trendSell = ready and trend == -1 and trend[1] == 1

// Kausal adaptiv reaktor og volumvektet alternativ på grafens egen tidsramme.
noise = ta.sma(math.abs(ta.change(close)), 10) * 10.0
er = noise > 0 ? math.min(1.0, math.abs(close - close[10]) / noise) : 0.0
alpha = math.pow(er * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
var float reactor = na
reactor := na(reactor[1]) ? close : reactor[1] + nz(alpha, 0.0) * (close - reactor[1])
volumeMean = ta.sma(volume, 20)
flex = ta.sma(hlc3 * volume, 20) / volumeMean
waveMean = ta.ema(hlc3, 20)
waveDev = ta.stdev(hlc3, 20)
rangeVolume = ta.sma(volume, 100)
rangeMid = ta.sma(hlc3 * volume, 100) / rangeVolume
rangeVar = math.max(0.0, ta.sma(hlc3 * hlc3 * volume, 100) / rangeVolume - rangeMid * rangeMid)
rangeDev = math.sqrt(rangeVar)
// Gaussisk, ensidig kjerne; ingen sentrering eller fremtidige observasjoner.
float kernel = 0.0
float weightSum = 0.0
for j = 0 to 15
    float weight = math.exp(-j * j / 32.0)
    kernel += nz(hlc3[j], hlc3) * weight
    weightSum += weight
kernel /= weightSum
assistant = trend == 1 ? kernel - 2.0 * atr : kernel + 2.0 * atr
rsi = ta.rsi(close, 14)
revUp = ready and close[1] < waveMean[1] - 2.0 * waveDev[1] and close > waveMean - 2.0 * waveDev and rsi[1] < 35
revDown = ready and close[1] > waveMean[1] + 2.0 * waveDev[1] and close < waveMean + 2.0 * waveDev and rsi[1] > 65
trendEnabled = signalMode == "Trend" or signalMode == "Trend + Reversal"
reversalEnabled = signalMode == "Reversal" or signalMode == "Trend + Reversal"
buyCandidate = (trendEnabled and trendBuy) or (reversalEnabled and revUp)
sellCandidate = (trendEnabled and trendSell) or (reversalEnabled and revDown)
buy = barstate.isconfirmed and buyCandidate and not sellCandidate
sell = barstate.isconfirmed and sellCandidate and not buyCandidate
primeScore = (trend == 1 ? 2.0 : 0.0) + (close > filtered ? 2.0 : 0.0) + (close > reactor ? 2.0 : 0.0) + (close > kernel ? 2.0 : 0.0) + (rsi > 50 ? 2.0 : 0.0)
consolidation = 10.0 * (1.0 - nz(er, 0.0))
strongBuy = buy and primeScore >= 8 and volume >= volumeMean
strongSell = sell and primeScore <= 2 and volume >= volumeMean
bullCandle = barstate.isconfirmed and showCandles and close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and volume > volumeMean
bearCandle = barstate.isconfirmed and showCandles and close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and volume > volumeMean

// Egen eksplisitt handelsplan. Originalen oppgir ingen slik fast ATR-profil.
// Nivåene fryses ved signalets close. Samme lys kan aldri fylle sin nye plan.
var int side = 0
var int born = na
var float entry = na
var float sl = na
var float tp1 = na
var float tp2 = na
var bool partial = false
bool hitTP1 = false
bool hitTP2 = false
bool hitSL = false
if barstate.isconfirmed
    if side != 0 and bar_index > born
        hitSL := side == 1 ? low <= sl : high >= sl
        hitTP2 := not hitSL and (side == 1 ? high >= tp2 : low <= tp2)
        hitTP1 := not hitSL and not partial and (side == 1 ? high >= tp1 : low <= tp1)
        if hitTP1
            partial := true
        if hitSL or hitTP2
            side := 0
    if buy or sell
        side := buy ? 1 : -1
        entry := close
        sl := close - side * stopATR * atr
        tp1 := close + side * tp1ATR * atr
        tp2 := close + side * tp2ATR * atr
        born := bar_index
        partial := false

bull = color.rgb(57, 247, 117)
bear = color.rgb(245, 74, 84)
candleColor = candleMode == "Trend Static" ? (trend == 1 ? bull : bear) : color.from_gradient(primeScore, 0, 10, bear, bull)
barcolor(candleMode == "Japanese Default" ? na : candleColor)
plotshape(buy and not strongBuy, "Buy", shape.labelup, location.belowbar, bull, text="Buy", textcolor=color.black, size=size.tiny)
plotshape(sell and not strongSell, "Sell", shape.labeldown, location.abovebar, bear, text="Sell", textcolor=color.white, size=size.tiny)
plotshape(strongBuy, "Strong Buy", shape.labelup, location.belowbar, bull, text="Buy+", textcolor=color.black, size=size.tiny)
plotshape(strongSell, "Strong Sell", shape.labeldown, location.abovebar, bear, text="Sell+", textcolor=color.white, size=size.tiny)
plotshape(reversalEnabled and revUp and barstate.isconfirmed, "Reversal Up", shape.triangleup, location.belowbar, color.aqua, size=size.tiny)
plotshape(reversalEnabled and revDown and barstate.isconfirmed, "Reversal Down", shape.triangledown, location.abovebar, color.orange, size=size.tiny)
plotshape(showTP and hitTP1, "Take Profit 1 · egen profil", shape.diamond, location.abovebar, color.purple, size=size.tiny)
plotshape(showTP and hitTP2, "Take Profit 2 · egen profil", shape.diamond, location.abovebar, color.red, size=size.small)
plotshape(bullCandle, "Bullish Candle", shape.circle, location.belowbar, bull, size=size.tiny)
plotshape(bearCandle, "Bearish Candle", shape.circle, location.abovebar, bear, size=size.tiny)
plot(reactorSelect == "Dynamic Reactor" or reactorSelect == "Both" ? reactor : na, "Dynamic Reactor · estimert", color=close > reactor ? bull : bear, linewidth=2)
plot(reactorSelect == "Volume Flex Reactor" or reactorSelect == "Both" ? flex : na, "Volume Flex Reactor · estimert", color=color.orange, linewidth=2)
p1 = plot(showBands ? waveMean + 2.0 * waveDev : na, "Momentum Upper · estimert", color=color.new(bear, 40))
p2 = plot(showBands ? waveMean - 2.0 * waveDev : na, "Momentum Lower · estimert", color=color.new(bull, 40))
fill(p1, p2, color=color.new(color.gray, 95))
plot(showRanges ? rangeMid : na, "Prime Range Mid · estimert", color=color.gray)
plot(showRanges ? rangeMid + rangeDev : na, "Prime Range +1 · estimert", color=color.new(bear, 30))
plot(showRanges ? rangeMid - rangeDev : na, "Prime Range -1 · estimert", color=color.new(bull, 30))
plot(showRanges ? rangeMid + 2.0 * rangeDev : na, "Prime Range +2 · estimert", color=color.new(bear, 50))
plot(showRanges ? rangeMid - 2.0 * rangeDev : na, "Prime Range -2 · estimert", color=color.new(bull, 50))
plot(showAssistant ? assistant : na, "Prime Trend Assistant · estimert", color=trend == 1 ? bull : bear, linewidth=2)
plot(showPlan and side != 0 ? entry : na, "Entry", color=color.gray, style=plot.style_linebr)
plot(showPlan and side != 0 ? sl : na, "Stop Loss", color=bear, style=plot.style_linebr)
plot(showPlan and side != 0 and not partial ? tp1 : na, "TP1", color=color.purple, style=plot.style_linebr)
plot(showPlan and side != 0 ? tp2 : na, "TP2", color=bull, style=plot.style_linebr)
// Maskinlesbar kontrakt. Signalnivåene beholdes også når referanseplanen er utløpt.
plot(buy ? 1 : 0, "Long Signal", display=display.none)
plot(sell ? 1 : 0, "Short Signal", display=display.none)
plot(entry, "Signal Entry", display=display.none)
plot(sl, "Signal SL", display=display.none)
plot(tp1, "Signal TP1", display=display.none)
plot(tp2, "Signal TP2", display=display.none)
plot(side, "Tracked Direction", display=display.none)
plot(trend, "Estimated Trend", display=display.none)
plot(filtered, "Low Pass", display=display.none)
plot(primeScore, "Prime Score", display=display.none)
plot(consolidation, "Consolidation Score", display=display.none)
alertcondition(buy, "Oracle Buy", "{{ticker}} Oracle RECON BUY {{close}}")
alertcondition(sell, "Oracle Sell", "{{ticker}} Oracle RECON SELL {{close}}")
alertcondition(hitTP1 or hitTP2, "Oracle Take Profit · egen profil", "{{ticker}} Oracle RECON TP {{close}}")
var table panel = table.new(position.bottom_right, 2, 4, bgcolor=color.new(color.black, 15))
if barstate.islast and showDashboard
    table.cell(panel, 0, 0, "ORACLE RECON", text_color=color.white)
    table.cell(panel, 1, 0, "ESTIMERT", text_color=color.orange)
    table.cell(panel, 0, 1, "Fast tuning", text_color=color.gray)
    table.cell(panel, 1, 1, str.tostring(tuning, "#.##"), text_color=color.white)
    table.cell(panel, 0, 2, showScore ? "Prime Score" : "", text_color=color.gray)
    table.cell(panel, 1, 2, showScore ? str.tostring(primeScore, "#.0") : "", text_color=candleColor)
    table.cell(panel, 0, 3, showConsolidation ? "Consolidation" : "", text_color=color.gray)
    table.cell(panel, 1, 3, showConsolidation ? str.tostring(consolidation, "#.0") : "", text_color=color.white)
