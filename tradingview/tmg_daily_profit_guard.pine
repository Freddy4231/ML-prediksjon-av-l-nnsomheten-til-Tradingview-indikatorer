//@version=6
// DAT158 · uavhengig TMG-inspirert signalmodell, ikke kanalens proprietære kode.
// Kilder: _GqbaF4lvrI ved 01:00/06:11 og OCnkVk2KG7o ved 04:00 på YouTube.
// Fryst valg: daily50_weekend_both + entry_guard. Placebokravet er ikke bestått. Kun 1 time, standardlys og samme Binance-mynt spot/perp.
// Gårsdagens UTC-close/SMA brukes først fra neste timebars åpning. Signaler ved close.
// CLV er et prisbasert volumestimat. Dette er ikke målt taker-CVD, OI eller likvidasjoner.
// Indikatoren legger ingen ordre. Historiske resultater er en separat 1× Python-simulering.
// SL/POC-utganger er close-beslutninger; ingen hvilende børsordre eller native strategitest.
indicator("TMG Dagsbekreftelse · Gevinstvern (forskning)", "TMG Gevinstvern", overlay=true, max_bars_back=1000, max_labels_count=500)
string spotSymbol = input.symbol("BINANCE:BTCUSDT", "Spotsymbol · velg samme mynt som futuresgrafen")
bool showRejected = input.bool(true, "Vis avviste signaler")
bool showContext = input.bool(true, "Vis dagsnivåer")
// Faste V2-standarder. Endring krever ny evaluering; dagens opprinnelige strategi er urørt.
bool useHtfAnchor = true
int htfAnchorMin = 100
int vpLookback = 100
int vpBins = 32
int vpStep = 4
float vaFraction = 0.70
float bgThreshold = 0.50
int liqLookback = 72
float minWickRatio = 0.40
float volSpikeMult = 1.50
float nmlThreshold = 0.85
bool validMarket = syminfo.prefix == "BINANCE" and str.endswith(syminfo.ticker, ".P") and spotSymbol == "BINANCE:" + str.replace_all(syminfo.ticker, ".P", "")
bool validTf = timeframe.in_seconds() == 3600 and chart.is_standard and validMarket
bool onlyLong = false
bool useWeekend = true
// ---------------- 2. Multi-Timeframe Skala, EMA-er, VWAP og Stonksy Regime ----------------
int tfSec = timeframe.in_seconds()
int tfMin = math.max(1, int(tfSec / 60))
int htfScale = useHtfAnchor ? int(math.min(4, math.max(1, math.round(float(htfAnchorMin) / float(tfMin))))) : 1

float atrBar = ta.atr(14)
float atrHtf = ta.atr(14 * htfScale)
float ema50 = ta.ema(close, 50 * htfScale)
float ema200 = ta.ema(close, 200 * htfScale)
float upRma = ta.rma(math.max(nz(ta.change(close)), 0), 14)
float downRma = ta.rma(math.max(-nz(ta.change(close)), 0), 14)
float rsi14 = downRma == 0 ? 100 : 100 - 100 / (1 + upRma / downRma)

int vwapLen = int(math.min(96, math.max(16, math.round(1440.0 / float(tfMin)))))
float effVol = volume > 0 ? volume : 1.0
float typPx = (high + low + close) / 3.0
float sumPvVwap = math.sum(typPx * effVol, vwapLen)
float sumVolVwap = math.sum(effVol, vwapLen)
float instVwap = sumVolVwap > 0 ? sumPvVwap / sumVolVwap : close

float hlcc4Val = (high + low + 2.0 * close) / 4.0
float fastMom = ta.ema(hlcc4Val, 12 * htfScale)
float slowMom = ta.ema(hlcc4Val, 26 * htfScale)
float rawMom = atrHtf > 0 ? (fastMom - slowMom) / atrHtf : 0.0
float osc = ta.ema(rawMom, 9 * htfScale) * 100.0
int oscState = osc > 0 ? (osc > nz(osc[1]) ? 2 : 1) : (osc < 0 ? (osc < nz(osc[1]) ? -2 : -1) : 0)

float spread = atrHtf > 0 ? (ema50 - ema200) / atrHtf : 0.0
var int bgRegime = 0
if na(spread) or na(ema50) or na(ema200)
    bgRegime := 0
else if bgRegime == 1
    if spread < -bgThreshold and close < ema200
        bgRegime := -1
    else if spread <= 0.0
        bgRegime := 0
else if bgRegime == -1
    if spread > bgThreshold and close > ema200
        bgRegime := 1
    else if spread >= 0.0
        bgRegime := 0
else
    if spread > bgThreshold and close > ema50
        bgRegime := 1
    else if spread < -bgThreshold and close < ema50
        bgRegime := -1

// ---------------- 3. CLV-estimert volumtrykk: Buy Pressure %, CVD & Absorpsjonsdivergens ----------------
float barRange = math.max(high - low, syminfo.mintick)
float clvBuy = math.min(math.max((close - low) / barRange, 0.0), 1.0)
float buyVol = volume > 0 ? volume * clvBuy : 0.5 * effVol
int flowLen = 12 * htfScale
float sumBuyFlow = math.sum(buyVol, flowLen)
float sumVolFlow = math.sum(effVol, flowLen)
float buyPressurePct = sumVolFlow > 0 ? 100.0 * sumBuyFlow / sumVolFlow : 50.0

float barDelta = 2.0 * buyVol - effVol
float cvd = ta.cum(barDelta)
int cvdLook = 6 * htfScale
float cvdSlope = cvd - nz(cvd[cvdLook], cvd)

float volMa20 = ta.sma(effVol, 20)
bool volSpike = not na(volMa20) and effVol >= volSpikeMult * volMa20

// ---------------- 4. Rullerende VRVP (POC, VAH, VAL) ----------------
int effVpLb = int(math.min(200, math.max(40, vpLookback * htfScale)))
int effVpStep = int(math.max(vpStep, 2 * htfScale))
float rangeHigh = ta.highest(high, effVpLb)
float rangeLow = ta.lowest(low, effVpLb)
var float poc = na
var float vah = na
var float val = na
var array<float> volHist = array.new_float(200, 0.0)

if validTf and bar_index >= effVpLb - 1 and ((bar_index - (effVpLb - 1)) % effVpStep == 0 or na(poc))
    float span = rangeHigh - rangeLow
    if span <= 0
        poc := close
        vah := close
        val := close
    else
        for b = 0 to vpBins - 1
            array.set(volHist, b, 0.0)
        float totalVol = 0.0
        for k = 0 to effVpLb - 1
            float typ = (high[k] + low[k] + close[k]) / 3.0
            float v = volume[k] > 0 ? volume[k] : 1.0
            int idx = int((typ - rangeLow) / span * vpBins)
            int binIdx = math.min(math.max(idx, 0), vpBins - 1)
            array.set(volHist, binIdx, array.get(volHist, binIdx) + v)
            totalVol += v
        int pocBin = 0
        float bestVol = -1.0
        for b = 0 to vpBins - 1
            float bv = array.get(volHist, b)
            if bv > bestVol
                bestVol := bv
                pocBin := b
        float stepPx = span / vpBins
        poc := rangeLow + (pocBin + 0.5) * stepPx
        float targetVol = totalVol * vaFraction
        float cumVol = bestVol
        int loB = pocBin
        int hiB = pocBin
        for iter = 0 to vpBins - 1
            if cumVol < targetVol and (loB > 0 or hiB < vpBins - 1)
                float downV = loB > 0 ? array.get(volHist, loB - 1) : -1.0
                float upV = hiB < vpBins - 1 ? array.get(volHist, hiB + 1) : -1.0
                if upV >= downV
                    hiB += 1
                    cumVol += upV
                else
                    loB -= 1
                    cumVol += downV
        val := rangeLow + loB * stepPx
        vah := rangeLow + (hiB + 1) * stepPx

// ---------------- 5. Pris-/volumsveip (ikke målte likvidasjoner) ----------------
int effLiqLb = int(math.min(144, math.max(20, liqLookback * htfScale)))
float prevLiqHigh = ta.highest(high, effLiqLb)[1]
float prevLiqLow = ta.lowest(low, effLiqLb)[1]

float lowerWickRatio = (math.min(open, close) - low) / barRange
float upperWickRatio = (high - math.max(open, close)) / barRange

int divLb = 10 * htfScale
bool bullDiv = low < nz(low[divLb], low) and cvd > nz(cvd[divLb], cvd)
bool bearDiv = high > nz(high[divLb], high) and cvd < nz(cvd[divLb], cvd)

bool bullSweep = not na(prevLiqLow) and low < prevLiqLow and close > prevLiqLow and lowerWickRatio >= minWickRatio and (barDelta > 0 or bullDiv) and volSpike and rsi14 < 40.0
bool bearSweep = not na(prevLiqHigh) and high > prevLiqHigh and close < prevLiqHigh and upperWickRatio >= minWickRatio and (barDelta < 0 or bearDiv) and volSpike and rsi14 > 60.0


// ---------------- Bekreftet dagskontekst og helgedeltakelse ----------------
[dailyClose, daily50, daily200] = request.security(syminfo.tickerid, "D", [close[1], ta.sma(close, 50)[1], ta.sma(close, 200)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[spot24, spot720] = request.security(spotSymbol, "60", [math.sum(volume, 24), math.sum(volume[24], 720)], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
float perp24 = math.sum(volume, 24)
float perp720 = math.sum(volume[24], 720)
bool confident = perp24 > 0 and perp720 > 0 and not na(spot24) and not na(spot720) and spot24 / perp24 >= spot720 / perp720
int utcDay = dayofweek(time_close, "UTC")
bool weekend = utcDay == dayofweek.saturday or utcDay == dayofweek.sunday
bool weekendPass = not useWeekend or not weekend or confident
bool dailyBull = dailyClose > daily50
bool dailyBear = dailyClose < daily50
bool allowLong = dailyBull and weekendPass
bool allowShort = dailyBear and weekendPass and not onlyLong

// ---------------- V2s tilstand ved close; helt separat fra filtrert mål ----------------
var int basePos = 0
var int tradedBgDir = 0
var string activeKind = ""
var float entryPx = na
var float trapSl = na
var float trapTp = na
var int filteredPos = 0
bool baseBuy = false
bool baseSell = false
bool filteredBuy = false
bool filteredSell = false
bool filteredExit = false
int warmupBars = int(math.max(effVpLb, 200))
if barstate.isconfirmed and validTf and bar_index >= warmupBars and not na(atrHtf) and not na(poc)
    if bgRegime == 0 or (tradedBgDir != 0 and bgRegime != tradedBgDir)
        tradedBgDir := 0
    if basePos == 1
        if activeKind == "trap"
            if high >= entryPx + 0.5 * (trapTp - entryPx)
                trapSl := math.max(trapSl, entryPx * 1.0015)
            if close <= trapSl or high >= trapTp
                basePos := 0
                activeKind := ""
        else if bgRegime <= 0
            basePos := 0
            activeKind := ""
    else if basePos == -1
        if activeKind == "trap"
            if low <= entryPx - 0.5 * (entryPx - trapTp)
                trapSl := math.min(trapSl, entryPx * 0.9985)
            if close >= trapSl or low <= trapTp
                basePos := 0
                activeKind := ""
        else if bgRegime >= 0
            basePos := 0
            activeKind := ""
    bool flowBull = buyPressurePct >= 50 or cvdSlope > 0
    bool flowBear = buyPressurePct <= 50 or cvdSlope < 0
    bool trendLong = bgRegime == 1 and tradedBgDir != 1 and close > ema200 and close >= instVwap and flowBull and oscState == 2 and close > ema50 and close >= poc and (close >= vah or spread >= nmlThreshold)
    bool trendShort = bgRegime == -1 and tradedBgDir != -1 and close < ema200 and close <= instVwap and flowBear and oscState == -2 and close < ema50 and close <= poc and (close <= val or spread <= -nmlThreshold)
    bool trapLong = basePos == 0 and bullSweep and close < val and (poc - close) > 1.3 * atrBar
    bool trapShort = basePos == 0 and bearSweep and close > vah and (close - poc) > 1.3 * atrBar
    if trendLong and basePos != 1
        basePos := 1
        activeKind := "trend"
        tradedBgDir := 1
        baseBuy := true
    else if trendShort and basePos != -1
        basePos := -1
        activeKind := "trend"
        tradedBgDir := -1
        baseSell := true
    else if trapLong
        basePos := 1
        activeKind := "trap"
        entryPx := close
        trapSl := math.max(low - 0.5 * atrBar, close * 0.975)
        trapTp := close + 0.88 * (poc - close)
        baseBuy := true
    else if trapShort
        basePos := -1
        activeKind := "trap"
        entryPx := close
        trapSl := math.min(high + 0.5 * atrBar, close * 1.025)
        trapTp := close - 0.88 * (close - poc)
        baseSell := true
    if filteredPos != 0 and basePos != filteredPos
        filteredPos := 0
        filteredExit := true
    if baseBuy and allowLong
        filteredPos := 1
        filteredBuy := true
    else if baseSell and allowShort
        filteredPos := -1
        filteredSell := true

// ---------------- Valgfritt gevinstvern · bare avsluttede close ----------------
// Beregnet fra signalprisen, ikke faktisk meglerfyll. Ingen garantert breakeven.
// Etter 2 ATR14 i beste close settes en linje ved inngang +/- 0,3 %.
// Linjen testes først på neste bar. Exit fylles i simuleringen neste ekte open.
var int protectedPos = 0
var float protectedEntry = na
var float protectedAtr = na
var float protectedPeak = na
var float protectionLine = na
var bool protectionArmed = false
bool protectedBuy = false
bool protectedSell = false
bool protectedExit = false
bool protectionExit = false
if barstate.isconfirmed and validTf
    if protectedPos != 0 and filteredPos != protectedPos
        protectedPos := 0
        protectedExit := true
    if protectedPos != 0
        if not na(protectionLine) and protectedPos * (close - protectionLine) <= 0
            protectedPos := 0
            protectedExit := true
            protectionExit := true
            protectionLine := na
        else
            protectedPeak := protectedPos == 1 ? math.max(protectedPeak, close) : math.min(protectedPeak, close)
            protectionArmed := protectionArmed or protectedPos * (protectedPeak - protectedEntry) >= 2.0 * protectedAtr
            if protectionArmed
                protectionLine := protectedEntry * (1.0 + protectedPos * 0.003)
    if protectedPos == 0 and not protectionExit and not na(atrBar) and atrBar > 0
        int freshDirection = filteredBuy ? 1 : filteredSell ? -1 : 0
        if freshDirection != 0
            protectedPos := freshDirection
            protectedEntry := close
            protectedAtr := atrBar
            protectedPeak := close
            protectionLine := na
            protectionArmed := false
            protectedBuy := protectedPos == 1
            protectedSell := protectedPos == -1
    if protectedPos == 0
        protectionLine := na
        protectionArmed := false
plot(protectedPos, "Vernet målposisjon", display=display.none)
plot(protectedPos != 0 ? protectionLine : na, "Close-vern · gjelder neste bar", color=#FFA94D, linewidth=2, style=plot.style_linebr)
plot(protectionExit ? 1 : 0, "Ekstra close-utgang", display=display.none)

// Et avvist signal blir aldri inngang senere uten et nytt grunnsignal.
plot(showContext ? daily50 : na, "Bekreftet SMA50 · dager", color=#00DCB9, linewidth=2)
plot(showContext ? daily200 : na, "Bekreftet SMA200 · dager", color=#9D83FF, linewidth=2)
plot(filteredPos, "Filtrert målposisjon", display=display.none)
plot(basePos, "Grunnmodellens målposisjon", display=display.none)
plotshape(protectedBuy, title="KJØP", text="KJØP", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.tiny)
plotshape(protectedSell, title="SELG / SHORT", text="SELG", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.tiny)
plotshape(protectedExit, title="LUKK", text="LUKK", style=shape.xcross, location=location.abovebar, color=color.yellow, size=size.tiny)
plotshape(showRejected and baseBuy and not allowLong, title="Avvist kjøp", style=shape.xcross, location=location.belowbar, color=color.gray, size=size.tiny)
plotshape(showRejected and baseSell and not allowShort, title="Avvist salg", style=shape.xcross, location=location.abovebar, color=color.gray, size=size.tiny)
bgcolor(validTf ? (dailyBull ? color.new(color.green, 94) : dailyBear ? color.new(color.red, 94) : na) : color.new(color.orange, 80), title="Dagskontekst")
alertcondition(protectedBuy, "TMG Dagsbekreftelse · KJØP", "Bekreftet, filtrert TMG KJØP. Ingen ordre fra indikatoren.")
alertcondition(protectedSell, "TMG Dagsbekreftelse · SELG", "Bekreftet, filtrert TMG SELG/SHORT. Ingen ordre fra indikatoren.")
alertcondition(protectedExit, "TMG Dagsbekreftelse · LUKK", "Grunnmodellen lukker eller vender. Ingen ordre fra indikatoren.")
var table status = table.new(position.top_right, 1, 4)
if barstate.islast
    table.cell(status, 0, 0, "TMG Gevinstvern · forskning", text_color=color.white)
    table.cell(status, 0, 1, validTf ? "1 time · bekreftede lys" : "Velg samsvarende Binance-perp/spot og vanlige 1-timerslys", text_color=validTf ? color.white : color.orange)
    table.cell(status, 0, 2, "Velg samme mynt spot og futures", text_color=color.white)
    table.cell(status, 0, 3, "Placebo ikke bestått · ingen ordre", text_color=color.orange)
